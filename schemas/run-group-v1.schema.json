{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:repotrials:schema:run-group:v1",
  "title": "RepoTrials run group",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_group",
    "status",
    "task_ids",
    "task_digests",
    "task_contract_digests",
    "attempts",
    "expected_trial_count",
    "agent",
    "model",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "repotrials.run-group/v1"},
    "run_group": {"type": "string", "minLength": 1},
    "status": {"enum": ["running", "complete"]},
    "task_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "task_digests": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "task_contract_digests": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "attempts": {"type": "integer", "minimum": 1},
    "expected_trial_count": {"type": "integer", "minimum": 1},
    "agent": {"type": "string", "minLength": 1},
    "model": {"type": ["string", "null"]},
    "created_at": {"type": "string", "minLength": 1},
    "run_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "completed_at": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "complete"}}},
      "then": {"required": ["run_ids", "completed_at"]},
      "else": {
        "not": {
          "anyOf": [
            {"required": ["run_ids"]},
            {"required": ["completed_at"]}
          ]
        }
      }
    }
  ]
}
