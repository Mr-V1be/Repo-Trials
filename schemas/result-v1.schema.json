{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:repotrials:schema:result:v1",
  "title": "RepoTrials trial result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "run_group",
    "attempt",
    "task_id",
    "system",
    "result"
  ],
  "properties": {
    "schema_version": {"const": "repotrials.run/v1"},
    "run_id": {"type": "string", "minLength": 1},
    "run_group": {"type": "string", "minLength": 1},
    "attempt": {"type": "integer", "minimum": 1},
    "task_id": {"type": "string", "minLength": 1},
    "system": {
      "type": "object",
      "required": ["name", "agent_command_sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "model": {"type": ["string", "null"]},
        "agent_command_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": true
    },
    "submission": {"type": "object"},
    "result": {
      "type": "object",
      "required": ["resolved", "failure_kind", "wall_seconds"],
      "properties": {
        "resolved": {"type": "boolean"},
        "failure_kind": {"type": ["string", "null"]},
        "wall_seconds": {"type": "number", "minimum": 0},
        "cost_usd": {"type": ["number", "null"], "minimum": 0}
      },
      "additionalProperties": true
    }
  }
}
